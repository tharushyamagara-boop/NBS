rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public indicators collection (read by public, written by authenticated admins)
    match /dashboard_indicators/{indicatorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Micro-catchment GIS layers & site interventions
    match /dashboard_sites/{siteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // System configurations and database driver states
    match /dashboard_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
