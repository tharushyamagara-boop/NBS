rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public media, GeoJSON files, and report PDFs
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site photos and intervention evidence
    match /interventions/{siteId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
